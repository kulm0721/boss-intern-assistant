{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowArbitraryExtensions": true,
    "paths": {
      "@": [
        "./src"
      ],
      "@/*": [
        "./src/*"
      ],
      "~": [
        "./src"
      ],
      "~/*": [
        "./src/*"
      ],
      "@@": [
        "."
      ],
      "@@/*": [
        "./*"
      ],
      "~~": [
        "."
      ],
      "~~/*": [
        "./*"
      ],
      "#build/ui": [
        "./node_modules/.nuxt-ui/ui"
      ],
      "#build/ui/*": [
        "./node_modules/.nuxt-ui/ui/*"
      ],
      "devlog-ui": [
        "./vendor/devlog-ui/src"
      ]
    }
  },
  "include": [
    "auto-imports.d.ts",
    "components.d.ts",
    "src/env.d.ts",
    "src/App.vue",
    "src/entrypoints/content.ts",
    "src/entrypoints/background.ts",
    "src/entrypoints/boss/index.ts",
    "src/entrypoints/options/main.ts",
    "src/entrypoints/demo/main.ts",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "scripts",
    "packages",
    "vendor/**/__tests__"
  ]
}
